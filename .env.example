NODE_ENV=development

# Backend BARU di backend/ (port 3001 — legacy server/api tetap di 3000 untuk CI3)
PORT=3001
AUTH_SECRET=ganti-dengan-string-acak-panjang

# MySQL EXISTING (jangan ubah nama DB/tabel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skripsi
DB_USER=root
DB_PASSWORD=

# Frontend (baru)
FRONTEND_URL=http://localhost:5173

# Legacy Node API (selama CI3 masih dipakai)
LEGACY_API_URL=http://localhost:3000/api
