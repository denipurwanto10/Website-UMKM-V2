NODE_ENV=development

# Backend BARU (port 3001 — legacy server/api tetap di 3000 untuk CI3)
PORT=3001
AUTH_SECRET=ganti-dengan-string-acak-min-32-karakter
AUTH_EXPIRES_SECONDS=3600

# MySQL EXISTING (jangan ubah nama DB/tabel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=skripsi
DB_USER=root
DB_PASSWORD=

# Frontend baru
FRONTEND_URL=http://localhost:5173

# Folder upload existing (relatif dari folder backend/)
UPLOAD_DIR=../uploads
